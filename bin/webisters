#!/usr/bin/env php
<?php declare(strict_types=1);

foreach (array_filter([
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    dirname(__DIR__, 2) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/projects/app/vendor/autoload.php',
    dirname(__DIR__, 3) . '/projects/one/vendor/autoload.php',
]) as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

require __DIR__ . '/../src/CLI/Kernel.php';

$kernel = new Webisters\CLI\Kernel();
exit($kernel->run($argv));
